# ==============================================================================
# BLOCKVAULT - Backend Environment Template (Safe for Version Control)
# ==============================================================================

PORT=10000
HOST=0.0.0.0
DB_PATH=database/blockvault.db
SESSION_DURATION_HOURS=24
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Resend HTTPS API settings. Keep the API key only in the backend environment.
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Use a persistent random secret (at least 32 characters); never rotate while
# pending OTPs exist, or those pending verification codes will stop working.
OTP_HASH_SECRET=
